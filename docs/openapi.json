{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "@stack/api",
    "description": "Builders-stack reference API. Hono + @hono/zod-openapi. Auth via Better Auth (/api/auth/*). CRUD /posts (reads public, writes session-scoped). GDPR data-rights at /me/export and /me/delete."
  },
  "components": {
    "schemas": {
      "Post": {
        "type": "object",
        "properties": {
          "id":        { "type": "string", "example": "p_abc123" },
          "title":     { "type": "string", "example": "Hello world" },
          "body":      { "type": "string", "example": "My first post." },
          "authorId":  { "type": "string", "example": "u_abc123" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-07-01T12:00:00.000Z" },
          "updatedAt": { "type": "string", "format": "date-time", "example": "2026-07-01T12:00:00.000Z" }
        },
        "required": ["id","title","body","authorId","createdAt","updatedAt"]
      },
      "NewPost": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "body":  { "type": "string", "minLength": 1, "maxLength": 100000 }
        },
        "required": ["title","body"]
      },
      "PatchPost": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "body":  { "type": "string", "minLength": 1, "maxLength": 100000 }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        },
        "required": ["error"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status":  { "type": "string", "example": "ok" },
          "service": { "type": "string", "example": "api" },
          "uptime":  { "type": "number", "example": 42.5 }
        },
        "required": ["status","service","uptime"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id":    { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "name":  { "type": "string" }
        },
        "required": ["id","email"]
      },
      "ExportResponse": {
        "type": "object",
        "properties": {
          "exportedAt": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/MeResponse" }
        }
      },
      "DeleteResponse": {
        "type": "object",
        "properties": {
          "deleted": { "type": "boolean" },
          "userId":  { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie set by Better Auth on sign-in (/api/auth/sign-in/*). Required for all write routes and /me."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "description": "Returns service status and uptime. No auth required.",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "Service is up",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI 3.1 specification",
        "description": "Machine-readable spec generated by @hono/zod-openapi from the route definitions.",
        "tags": ["meta"],
        "responses": {
          "200": { "description": "OpenAPI document", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI",
        "description": "Interactive API explorer served by @hono/swagger-ui. Reads /openapi.json.",
        "tags": ["meta"],
        "responses": {
          "200": { "description": "HTML page" }
        }
      }
    },
    "/api/auth/{path}": {
      "get": {
        "summary": "Better Auth — GET handler",
        "description": "Catch-all for Better Auth GET requests (email verification, OAuth callbacks, session checks). See Better Auth docs for full route list.",
        "tags": ["auth"],
        "parameters": [{ "name": "path", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Auth response (varies by sub-path)" } }
      },
      "post": {
        "summary": "Better Auth — POST handler",
        "description": "Catch-all for Better Auth POST requests (sign-up, sign-in/email+password, sign-in/social, sign-out, change-password, …). Body shape depends on the sub-path.",
        "tags": ["auth"],
        "parameters": [{ "name": "path", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Auth response (varies by sub-path)" } }
      }
    },
    "/me": {
      "get": {
        "summary": "Current user",
        "description": "Returns the authenticated user's profile from the Better Auth session. Proves the session guard is working end-to-end.",
        "tags": ["auth"],
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Authenticated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } } },
          "401": { "description": "Not signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/me/export": {
      "get": {
        "summary": "GDPR data export",
        "description": "Returns the caller's own user row as a JSON attachment (Content-Disposition: attachment). Starter scope: the Better Auth user row only. Extend to app-owned tables (posts, …) before relying on this for a real DSAR. See docs/gdpr.md.",
        "tags": ["gdpr"],
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "User data export",
            "headers": { "Content-Disposition": { "schema": { "type": "string", "example": "attachment; filename=\"my-data.json\"" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportResponse" } } }
          },
          "401": { "description": "Not signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/me/delete": {
      "post": {
        "summary": "GDPR erasure (right to be forgotten)",
        "description": "Deletes the caller's own user row. Sessions and accounts cascade via FK onDelete: cascade. Starter scope — extend to app-owned tables before a real DSAR. See docs/gdpr.md.",
        "tags": ["gdpr"],
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteResponse" } } } },
          "401": { "description": "Not signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/posts": {
      "get": {
        "summary": "List posts",
        "description": "Returns all posts. Public — no auth required.",
        "tags": ["posts"],
        "responses": {
          "200": { "description": "All posts", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } } } } }
        }
      },
      "post": {
        "summary": "Create post",
        "description": "Creates a new post owned by the authenticated user. authorId is ALWAYS derived from the session — it is not accepted from the body (BOLA prevention).",
        "tags": ["posts"],
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewPost" } } }
        },
        "responses": {
          "201": { "description": "Created post", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get post",
        "description": "Returns a single post by ID. Public.",
        "tags": ["posts"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "The post", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "summary": "Update post",
        "description": "Partial update. Requires a session and ownership (authorId must match the session user). Returns 403 Forbidden if the caller doesn't own the post.",
        "tags": ["posts"],
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatchPost" } } }
        },
        "responses": {
          "200": { "description": "Updated post", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Forbidden — not the author", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "summary": "Delete post",
        "description": "Deletes a post. Requires a session and ownership. Returns 204 No Content on success.",
        "tags": ["posts"],
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Forbidden — not the author", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "tags": [
    { "name": "meta",  "description": "Liveness, OpenAPI spec, Swagger UI" },
    { "name": "auth",  "description": "Better Auth session management" },
    { "name": "gdpr",  "description": "GDPR data rights — export and erasure (scoped to the calling user)" },
    { "name": "posts", "description": "Example CRUD resource — the pattern to copy for real features" }
  ]
}
